{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/Report",
    "definitions": {
        "Report": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "summary": {
                    "type": "array",
                    "items": {
                        "$ref": "rich_text.json#/definitions/RichText"
                    }
                },
                "content": {
                    "$ref": "#/definitions/ReportContent"
                }
            },
            "required": [
                "content",
                "summary"
            ],
            "title": "Report"
        },
        "ReportContent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "content_sources": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "gmail": {
                    "$ref": "#/definitions/Gmail"
                }
            },
            "required": [
                "content_sources"
            ],
            "title": "ReportContent"
        },
        "Gmail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "essential": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/MailReportItem"
                    }
                },
                "non_essential": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/MailReportItem"
                    }
                }
            },
            "required": [
                "essential",
                "non_essential"
            ],
            "title": "Gmail"
        },
        "MailReportItem": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "message_id": {
                    "type": "string"
                },
                "thread_id": {
                    "type": "string"
                },
                "receive_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "sender": {
                    "type": "string"
                },
                "subject": {
                    "type": "string"
                },
                "summary": {
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "action": {
                    "type": "string"
                }
            },
            "required": [
                "action",
                "message_id",
                "receive_at",
                "sender",
                "subject",
                "summary",
                "tags",
                "thread_id"
            ],
            "title": "MailReportItem"
        }
    }
}
