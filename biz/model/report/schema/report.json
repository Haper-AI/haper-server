{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$ref": "#/definitions/Report",
  "definitions": {
    "Report": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "messages_in_queue": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "./rich_text.json#/definitions/RichText"
          }
        },
        "content": {
          "$ref": "#/definitions/ReportContent"
        }
      },
      "required": [
        "messages_in_queue",
        "content",
        "summary"
      ],
      "title": "Report"
    },
    "ReportContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gmail": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MailReportItem"
          }
        }
      },
      "required": [
        "content_sources"
      ],
      "title": "ReportContent"
    },
    "MailReportItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "integer"
        },
        "message_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "receive_at": {
          "type": "string",
          "format": "date-time"
        },
        "sender": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "type": "string"
        }
      },
      "required": [
        "_id",
        "action",
        "message_id",
        "receive_at",
        "sender",
        "subject",
        "summary",
        "category",
        "tags",
        "thread_id"
      ],
      "title": "MailReportItem"
    }
  }
}
